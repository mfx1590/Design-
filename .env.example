# Copy to .env.local and fill in. Never commit .env.local.
# Public origin of the site, no trailing slash. In production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: owner creates the project at sanity.io/manage and pastes the project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
SANITY_API_READ_TOKEN=

# Analytics (optional, cookieless): vercel | plausible. Plausible also needs the domain.
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# WhatsApp number, international format, digits only (no plus sign, no spaces). Defaults to the business number in lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=905488618449
