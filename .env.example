# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: owner creates the project at sanity.io/manage and pastes the project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
SANITY_API_READ_TOKEN=

# Resend: owner creates the account and an API key (Phase 5)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# WhatsApp number, international format, digits only (no plus sign, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=
